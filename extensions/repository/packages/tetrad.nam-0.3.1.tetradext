{"format":1,"manifest":{"id":"tetrad.nam","name":"Neural Amp Modeler","version":"0.3.1","description":"Plays Neural Amp Modeler LSTM and WaveNet models (.nam files) as DSP blocks, including the trainer's nano, feather and lite sizes. Copy .nam files to the extension's asset folder; each becomes a Guitar Amplifier block.","api":2,"capabilities":["blocks"],"settings":[],"commands":[],"blocks":[{"id":"amp","name":"NAM","category":"guitar_amplifier","generated":true,"asset":{"label":"NAM model","extensions":[".nam"]}}]},"module":"// src/nam.ts\nvar SAMPLE_RATE = 48e3;\nfunction read(name, text) {\n  let json;\n  try {\n    json = JSON.parse(text);\n  } catch {\n    throw new Error(`${name} is not a .nam file (it is not JSON)`);\n  }\n  const file = record(json, name);\n  const rate = file[\"sample_rate\"];\n  if (rate !== void 0 && rate !== null && rate !== SAMPLE_RATE) {\n    throw new Error(`${name} is for ${String(rate)} Hz; the QC runs at ${SAMPLE_RATE} Hz`);\n  }\n  return {\n    name,\n    architecture: file[\"architecture\"],\n    config: record(file[\"config\"], `${name} config`),\n    weights: numbers(file[\"weights\"], `${name} weights`)\n  };\n}\nfunction parseLstm({ name, config, weights }) {\n  const channels = (key) => {\n    const value = config[key];\n    return value === void 0 ? 1 : count(value, `${name} ${key}`);\n  };\n  if (channels(\"in_channels\") !== 1 || channels(\"out_channels\") !== 1) {\n    throw new Error(`${name} has more than one input or output channel`);\n  }\n  const inputSize = config[\"input_size\"] === void 0 ? 1 : count(config[\"input_size\"], `${name} input_size`);\n  const model = {\n    inputSize,\n    hiddenSize: count(config[\"hidden_size\"], `${name} hidden_size`),\n    numLayers: count(config[\"num_layers\"], `${name} num_layers`),\n    weights\n  };\n  if (model.inputSize !== 1) throw new Error(`${name} has input_size ${model.inputSize}; only 1 is supported`);\n  const expected = weightCount(model);\n  if (model.weights.length !== expected) {\n    throw new Error(`${name} has ${model.weights.length} weights; its config needs ${expected}`);\n  }\n  return model;\n}\nfunction weightCount({ inputSize, hiddenSize: h, numLayers }) {\n  let total = h + 1;\n  for (let layer = 0; layer < numLayers; layer++) {\n    const input = layer === 0 ? inputSize : h;\n    total += 4 * h * (input + h) + 4 * h + 2 * h;\n  }\n  return total;\n}\nfunction lstm(dsp, model) {\n  const { hiddenSize: h, weights } = model;\n  let at = 0;\n  const take = (n) => {\n    const values = weights.slice(at, at + n);\n    at += n;\n    return values;\n  };\n  dsp.mono();\n  const inputGain = dsp.parameter(\"Input\", 0, 4, 1);\n  const outputGain = dsp.parameter(\"Output\", 0, 4, 1);\n  let x = [dsp.mul(dsp.input(), inputGain)];\n  for (let layer = 0; layer < model.numLayers; layer++) {\n    const columns = x.length + h;\n    const w = take(4 * h * columns);\n    const b = take(4 * h);\n    const h0 = take(h);\n    const c0 = take(h);\n    const hidden = h0.map((value) => dsp.state(value));\n    const cell = c0.map((value) => dsp.state(value));\n    const xh = [...x, ...hidden.map((state) => state.signal)];\n    const gate = (row) => dot(dsp, w.slice(row * columns, (row + 1) * columns), xh, b[row] ?? 0);\n    const next = [];\n    for (let k = 0; k < h; k++) {\n      const input = dsp.sigmoid(gate(k));\n      const forget = dsp.sigmoid(gate(h + k));\n      const candidate = dsp.tanh(gate(2 * h + k));\n      const output = dsp.sigmoid(gate(3 * h + k));\n      const kept = dsp.mul(forget, at0(cell, k).signal);\n      const added = dsp.mul(input, candidate);\n      const c = dsp.add(kept, added);\n      const hNew = dsp.mul(output, dsp.tanh(c));\n      dsp.updateState(at0(cell, k), c);\n      dsp.updateState(at0(hidden, k), hNew);\n      next.push(hNew);\n    }\n    x = next;\n  }\n  const head = take(h);\n  const [bias = 0] = take(1);\n  const out = dsp.mul(dot(dsp, head, x, bias), outputGain);\n  return dsp.finish(out);\n}\nfunction dot(dsp, weights, values, bias) {\n  let sum = dsp.constant(bias);\n  weights.forEach((weight, j) => {\n    if (weight !== 0) sum = dsp.add(sum, dsp.mul(dsp.constant(weight), at0(values, j)));\n  });\n  return sum;\n}\nfunction at0(values, index) {\n  const value = values[index];\n  if (value === void 0) throw new Error(`index ${index} is out of range`);\n  return value;\n}\nfunction record(value, what) {\n  if (typeof value !== \"object\" || value === null || Array.isArray(value)) {\n    throw new Error(`${what} is not an object`);\n  }\n  return value;\n}\nfunction count(value, what) {\n  if (typeof value !== \"number\" || !Number.isInteger(value) || value < 1 || value > 64) {\n    throw new Error(`${what} must be a whole number from 1 to 64`);\n  }\n  return value;\n}\nfunction numbers(value, what) {\n  if (!Array.isArray(value)) throw new Error(`${what} is not a list`);\n  return value.map((item, index) => {\n    if (typeof item !== \"number\" || !Number.isFinite(item)) {\n      throw new Error(`${what}[${index}] is not a finite number`);\n    }\n    return item;\n  });\n}\n\n// src/wavenet.ts\nvar MAX_COMPILED_NODES = 24576;\nvar MAX_STATE_BYTES = 32767;\nvar STOCK_STATE_WORDS = 17;\nvar TANH_NODES = 36;\nvar SIGMOID_NODES = 40;\nvar RECIP_NODES = 12;\nvar SIZES = {\n  \"16/8\": \"standard\",\n  \"12/6\": \"lite\",\n  \"8/4\": \"feather\",\n  \"4/2\": \"nano\"\n};\nvar MAX_DILATION = 1 << 16;\nvar NETWORK_MAX_KERNEL = 16;\nvar NETWORK_MAX_CHANNELS = 64;\nvar FILM_KEYS = [\n  \"conv_pre_film\",\n  \"conv_post_film\",\n  \"input_mixin_pre_film\",\n  \"input_mixin_post_film\",\n  \"activation_pre_film\",\n  \"activation_post_film\",\n  \"layer1x1_post_film\",\n  \"head1x1_post_film\"\n];\nvar KNOWN_KEYS = /* @__PURE__ */ new Set([\n  \"input_size\",\n  \"condition_size\",\n  \"head_size\",\n  \"head_bias\",\n  \"head\",\n  \"channels\",\n  \"bottleneck\",\n  \"kernel_size\",\n  \"dilations\",\n  \"activation\",\n  \"gated\",\n  \"gating_mode\",\n  \"secondary_activation\",\n  \"groups_input\",\n  \"groups_input_mixin\",\n  \"layer1x1\",\n  \"head1x1\",\n  ...FILM_KEYS\n]);\nfunction parseWavenet({ name, config, weights }) {\n  const refuse = (what) => new Error(`${name} uses ${what}, which this version does not play`);\n  if (config[\"head\"] != null) throw refuse(\"a post-stack head\");\n  if (config[\"condition_dsp\"] != null) throw refuse(\"a condition DSP\");\n  if ((config[\"in_channels\"] ?? 1) !== 1 || (config[\"out_channels\"] ?? 1) !== 1) {\n    throw new Error(`${name} has more than one input or output channel`);\n  }\n  const layers = config[\"layers\"];\n  if (!Array.isArray(layers) || layers.length === 0) throw new Error(`${name} has no layer arrays`);\n  const arrays = layers.map((value, i) => {\n    const where = `${name} layer array ${i + 1}`;\n    return layerArray(record(value, where), where, refuse);\n  });\n  arrays.forEach((array, i) => {\n    const where = `${name} layer array ${i + 1}`;\n    const previous = arrays[i - 1];\n    const input = previous?.channels ?? 1;\n    if (array.inputSize !== input) {\n      throw new Error(`${where} has input_size ${array.inputSize}; it needs ${input}`);\n    }\n    if (previous !== void 0 && array.channels !== previous.headSize) {\n      throw new Error(`${where} has ${array.channels} channels; the head before it has ${previous.headSize}`);\n    }\n  });\n  const last = at0(arrays, arrays.length - 1);\n  if (last.headSize !== 1) throw new Error(`${name} has head_size ${last.headSize}; a mono model needs 1`);\n  const expected = weightCount2(arrays);\n  if (weights.length !== expected) {\n    throw new Error(`${name} has ${weights.length} weights; its config needs ${expected}`);\n  }\n  return { name, arrays, weights };\n}\nfunction layerArray(config, where, refuse) {\n  const unknown = Object.keys(config).find((key) => !KNOWN_KEYS.has(key));\n  if (unknown !== void 0) throw refuse(`\"${unknown}\"`);\n  for (const key of FILM_KEYS) {\n    const film = config[key];\n    if (film !== void 0 && film !== false && !(isObject(film) && film[\"active\"] === false)) {\n      throw refuse(`FiLM (${key})`);\n    }\n  }\n  if ((config[\"groups_input\"] ?? 1) !== 1 || (config[\"groups_input_mixin\"] ?? 1) !== 1) {\n    throw refuse(\"grouped convolutions\");\n  }\n  const channels = count(config[\"channels\"], `${where} channels`);\n  if ((config[\"bottleneck\"] ?? channels) !== channels) throw refuse(\"a bottleneck\");\n  const layer1x1 = config[\"layer1x1\"];\n  const plainLayer1x1 = isObject(layer1x1) && layer1x1[\"active\"] === true && (layer1x1[\"groups\"] ?? 1) === 1;\n  if (layer1x1 !== void 0 && !plainLayer1x1) throw refuse(\"layer1x1 settings\");\n  const head1x1 = config[\"head1x1\"];\n  if (head1x1 !== void 0 && !(isObject(head1x1) && head1x1[\"active\"] === false)) throw refuse(\"a head 1x1\");\n  if (count(config[\"condition_size\"], `${where} condition_size`) !== 1) {\n    throw refuse(\"a condition of more than one channel\");\n  }\n  let headSize;\n  let headBias;\n  const head = config[\"head\"];\n  if (head != null) {\n    const nested = record(head, `${where} head`);\n    if (nested[\"kernel_size\"] !== 1 || (nested[\"head_dilation\"] ?? 1) !== 1) {\n      throw refuse(\"a head kernel wider than 1\");\n    }\n    headSize = count(nested[\"out_channels\"], `${where} head out_channels`);\n    headBias = nested[\"bias\"];\n  } else {\n    headSize = count(config[\"head_size\"], `${where} head_size`);\n    headBias = config[\"head_bias\"];\n  }\n  if (typeof headBias !== \"boolean\") throw new Error(`${where} head bias is not true or false`);\n  return {\n    inputSize: count(config[\"input_size\"], `${where} input_size`),\n    channels,\n    headSize,\n    headBias,\n    kernelSize: count(config[\"kernel_size\"], `${where} kernel_size`),\n    dilations: dilations(config[\"dilations\"], `${where} dilations`),\n    activation: activation(config[\"activation\"], where, refuse),\n    gated: gated(config, where, refuse)\n  };\n}\nfunction activation(value, where, refuse) {\n  const type = isObject(value) ? value[\"type\"] : value;\n  switch (type) {\n    case \"Tanh\":\n    case \"Fasttanh\":\n      return \"Tanh\";\n    case \"Hardtanh\":\n      return \"Hardtanh\";\n    case \"ReLU\":\n      return \"ReLU\";\n    default:\n      if (typeof type !== \"string\") throw new Error(`${where} activation is not one activation name`);\n      throw refuse(`the ${type} activation`);\n  }\n}\nfunction gated(config, where, refuse) {\n  const mode = config[\"gating_mode\"];\n  let result;\n  if (mode === void 0) {\n    const flag = config[\"gated\"] ?? false;\n    if (typeof flag !== \"boolean\") throw new Error(`${where} gated is not true or false`);\n    result = flag;\n  } else if (mode === \"gated\" || mode === \"none\") {\n    result = mode === \"gated\";\n  } else {\n    throw refuse(typeof mode === \"string\" ? `the ${mode} gating mode` : \"a gating mode for each layer\");\n  }\n  const secondary = config[\"secondary_activation\"];\n  const type = isObject(secondary) ? secondary[\"type\"] : secondary;\n  if (secondary !== void 0 && !(result && type === \"Sigmoid\")) {\n    throw refuse(\"a secondary activation other than a Sigmoid gate\");\n  }\n  return result;\n}\nfunction dilations(value, what) {\n  if (!Array.isArray(value) || value.length === 0) throw new Error(`${what} is not a list of layers`);\n  return value.map((item) => {\n    if (typeof item !== \"number\" || !Number.isInteger(item) || item < 1 || item > MAX_DILATION) {\n      throw new Error(`${what} must be whole numbers from 1 to ${MAX_DILATION}`);\n    }\n    return item;\n  });\n}\nfunction isObject(value) {\n  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n}\nfunction weightCount2(arrays) {\n  let total = 1;\n  for (const { inputSize, channels: c, headSize: h, headBias, kernelSize: k, dilations: dilations2, gated: gated2 } of arrays) {\n    const z = gated2 ? 2 * c : c;\n    total += c * inputSize + dilations2.length * (z * c * k + z + z + c * c + c) + h * c + (headBias ? h : 0);\n  }\n  return total;\n}\nfunction wavenet(dsp, model) {\n  const fits = (array) => !array.gated && array.kernelSize <= NETWORK_MAX_KERNEL && [array.inputSize, array.channels, array.headSize].every((n) => n <= NETWORK_MAX_CHANNELS);\n  if (model.arrays.every(fits)) return network(dsp, model);\n  const size = new Size();\n  graph(size, model);\n  if (size.nodes > MAX_COMPILED_NODES || size.stateBytes > MAX_STATE_BYTES) {\n    const channels = model.arrays.map((array) => array.channels).join(\"/\");\n    const kind = SIZES[channels] ?? `with ${channels} channels`;\n    throw new Error(\n      `${model.name} (WaveNet ${kind}) needs ${size.nodes} DSP nodes and ${size.stateBytes} bytes of state; this version plays models up to ${MAX_COMPILED_NODES} nodes and ${MAX_STATE_BYTES} bytes. Use an LSTM model or a WaveNet with fewer channels or shorter dilations.`\n    );\n  }\n  return graph(dsp, model);\n}\nfunction network(dsp, model) {\n  let at = 0;\n  const take = (n) => {\n    const values = model.weights.slice(at, at + n);\n    at += n;\n    return values;\n  };\n  const inputGain = dsp.parameter(\"Input\", 0, 4, 1);\n  const outputGain = dsp.parameter(\"Output\", 0, 4, 1);\n  const net = dsp.network();\n  const x = net.input();\n  net.gain(x, inputGain);\n  let input = x;\n  let head;\n  for (const array of model.arrays) {\n    const { channels: c, kernelSize: k, activation: activation2 } = array;\n    let v = net.buffer(c);\n    net.conv(input, v, { weights: take(c * array.inputSize) });\n    let sum = head;\n    for (const dilation of array.dilations) {\n      const z = net.buffer(c);\n      net.conv(v, z, { kernel: k, dilation, weights: take(c * c * k), bias: take(c) });\n      net.conv(x, z, { weights: take(c), accumulate: true });\n      net.activation(z, ACTIVATIONS[activation2]);\n      if (sum === void 0) {\n        sum = net.buffer(c);\n        net.copy(z, sum);\n      } else {\n        net.add(z, sum);\n      }\n      const next = net.buffer(c);\n      net.conv(z, next, { weights: take(c * c), bias: take(c) });\n      net.add(v, next);\n      v = next;\n    }\n    if (sum === void 0) throw new Error(\"a layer array has no layers\");\n    const out = net.buffer(array.headSize);\n    const weights = take(array.headSize * c);\n    net.conv(sum, out, { weights, ...array.headBias ? { bias: take(array.headSize) } : {} });\n    head = out;\n    input = v;\n  }\n  if (head === void 0) throw new Error(\"the model has no layer arrays\");\n  const [scale = 0] = take(1);\n  return dsp.finish(dsp.mul(dsp.mul(net.output(head), dsp.constant(scale)), outputGain));\n}\nvar ACTIVATIONS = { Tanh: \"tanh\", Hardtanh: \"hardtanh\", ReLU: \"relu\" };\nfunction graph(dsp, model) {\n  let at = 0;\n  const take = (n) => {\n    const values = model.weights.slice(at, at + n);\n    at += n;\n    return values;\n  };\n  dsp.mono();\n  const inputGain = dsp.parameter(\"Input\", 0, 4, 1);\n  const outputGain = dsp.parameter(\"Output\", 0, 4, 1);\n  const x = dsp.mul(dsp.input(), inputGain);\n  let input = [x];\n  let head;\n  for (const array of model.arrays) {\n    const { channels: c, kernelSize: k } = array;\n    const z = array.gated ? 2 * c : c;\n    let v = matrix(dsp, take(c * input.length), input);\n    let sum = head;\n    for (const dilation of array.dilations) {\n      const conv = take(z * c * k);\n      const convBias = take(z);\n      const mixin = take(z);\n      const layer1x1 = take(c * c);\n      const layerBias = take(c);\n      const past = taps(dsp, v, k, dilation);\n      const pre = range(z).map((o) => {\n        const terms = [[at0(mixin, o), x]];\n        for (let j = 0; j < c; j++) {\n          for (let tap = 0; tap < k; tap++) {\n            terms.push([at0(conv, (o * c + j) * k + tap), at0(at0(past, k - 1 - tap), j)]);\n          }\n        }\n        return affine(dsp, terms, at0(convBias, o));\n      });\n      const a = range(c).map((o) => {\n        const value = activate(dsp, array.activation, at0(pre, o));\n        return array.gated ? dsp.mul(value, dsp.sigmoid(at0(pre, c + o))) : value;\n      });\n      sum = sum === void 0 ? a : sum.map((s, j) => dsp.add(s, at0(a, j)));\n      const mixed = matrix(dsp, layer1x1, a, layerBias);\n      v = v.map((value, o) => dsp.add(value, at0(mixed, o)));\n    }\n    if (sum === void 0) throw new Error(\"a layer array has no layers\");\n    head = matrix(dsp, take(array.headSize * c), sum, array.headBias ? take(array.headSize) : void 0);\n    input = v;\n  }\n  const [scale = 0] = take(1);\n  const out = dsp.mul(dsp.mul(at0(head ?? [], 0), dsp.constant(scale)), outputGain);\n  return dsp.finish(out);\n}\nfunction taps(dsp, values, kernel, dilation) {\n  const past = [[...values]];\n  for (let m = 1; m < kernel; m++) {\n    past.push(\n      at0(past, m - 1).map((value) => {\n        const line = dsp.delay(dilation);\n        dsp.updateDelay(line, value);\n        return line.signal;\n      })\n    );\n  }\n  return past;\n}\nfunction matrix(dsp, weights, values, bias) {\n  const n = values.length;\n  return range(weights.length / n).map(\n    (row) => affine(\n      dsp,\n      values.map((value, j) => [at0(weights, row * n + j), value]),\n      bias === void 0 ? 0 : at0(bias, row)\n    )\n  );\n}\nfunction affine(dsp, terms, bias) {\n  let sum = bias === 0 ? void 0 : dsp.constant(bias);\n  for (const [weight, value] of terms) {\n    if (weight === 0) continue;\n    const product = dsp.mul(dsp.constant(weight), value);\n    sum = sum === void 0 ? product : dsp.add(sum, product);\n  }\n  return sum ?? dsp.constant(0);\n}\nfunction activate(dsp, activation2, value) {\n  switch (activation2) {\n    case \"Tanh\":\n      return dsp.tanh(value);\n    case \"Hardtanh\":\n      return dsp.min(dsp.max(value, dsp.constant(-1)), dsp.constant(1));\n    case \"ReLU\":\n      return dsp.max(value, dsp.constant(0));\n  }\n}\nfunction range(n) {\n  return Array.from({ length: n }, (_, i) => i);\n}\nvar Size = class {\n  constructor() {\n    /** Node 0 is the input. */\n    this.nodes = 1;\n    this.parameters = 0;\n    this.memories = 0;\n    this.delaySamples = 0;\n  }\n  get stateBytes() {\n    return 4 * (STOCK_STATE_WORDS + this.parameters + this.memories + this.delaySamples);\n  }\n  push(nodes = 1) {\n    this.nodes += nodes;\n    return this.nodes;\n  }\n  input() {\n    return 0;\n  }\n  constant() {\n    return this.push();\n  }\n  parameter() {\n    this.parameters += 1;\n    return this.push();\n  }\n  state() {\n    this.memories += 1;\n    return { signal: this.push() };\n  }\n  delay(samples) {\n    this.memories += 1;\n    this.delaySamples += samples;\n    return { signal: this.push() };\n  }\n  add() {\n    return this.push();\n  }\n  sub() {\n    return this.push();\n  }\n  mul() {\n    return this.push();\n  }\n  min() {\n    return this.push();\n  }\n  max() {\n    return this.push();\n  }\n  div() {\n    return this.push(RECIP_NODES + 1);\n  }\n  neg() {\n    return this.push();\n  }\n  abs() {\n    return this.push();\n  }\n  recip() {\n    return this.push(RECIP_NODES);\n  }\n  tanh() {\n    return this.push(TANH_NODES);\n  }\n  sigmoid() {\n    return this.push(SIGMOID_NODES);\n  }\n  updateState() {\n  }\n  updateDelay() {\n  }\n  mono() {\n  }\n  network() {\n    throw new Error(\"gated models use the scalar graph\");\n  }\n  finish() {\n    return {};\n  }\n};\n\n// src/index.ts\nvar extension = {\n  activate(ctx) {\n    ctx.blocks.provide(\"amp\", (asset) => {\n      const file = read(asset.name, asset.text);\n      switch (file.architecture) {\n        case \"LSTM\":\n          return lstm(ctx.blocks.builder(), parseLstm(file));\n        case \"WaveNet\":\n          return wavenet(ctx.blocks.builder(), parseWavenet(file));\n        default:\n          throw new Error(\n            `${asset.name} is a ${String(file.architecture)} model; this version plays LSTM and WaveNet models only`\n      