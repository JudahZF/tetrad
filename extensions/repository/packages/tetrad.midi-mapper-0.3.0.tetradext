{"format":1,"manifest":{"id":"tetrad.midi-mapper","name":"MIDI Mapper","version":"0.3.0","description":"Sends MIDI CCs, notes and program changes on one channel to Mappings as triggers. Choose what each one does on the Mappings page.","api":3,"capabilities":["midiReceive","triggers"],"settings":[{"key":"channel","label":"MIDI channel","kind":"choice","options":[{"value":1,"label":"Channel 1"},{"value":2,"label":"Channel 2"},{"value":3,"label":"Channel 3"},{"value":4,"label":"Channel 4"},{"value":5,"label":"Channel 5"},{"value":6,"label":"Channel 6"},{"value":7,"label":"Channel 7"},{"value":8,"label":"Channel 8"},{"value":9,"label":"Channel 9"},{"value":10,"label":"Channel 10"},{"value":11,"label":"Channel 11"},{"value":12,"label":"Channel 12"},{"value":13,"label":"Channel 13"},{"value":14,"label":"Channel 14"},{"value":15,"label":"Channel 15"},{"value":16,"label":"Channel 16"}],"default":1}],"commands":[]},"module":"// src/index.ts\nvar TRIGGER = \"midi\";\nvar extension = {\n  activate(ctx) {\n    const { channel } = ctx.config;\n    ctx.midi.reserveChannel(channel);\n    ctx.triggers.declare({ id: TRIGGER, label: `Ch ${channel}` });\n    ctx.midi.onMessage(async (message, scope) => {\n      await scope.triggers.fire(toFiring(message));\n    });\n    ctx.lifecycle.onRunning((scope) => scope.ui.setStatus([`Channel ${channel} \\xB7 sends triggers to Mappings`]));\n  }\n};\nvar index_default = extension;\nfunction toFiring(message) {\n  switch (message.kind) {\n    case \"cc\": {\n      const { controller, value } = message;\n      return { trigger: TRIGGER, source: `cc:${controller}`, label: `CC ${controller}`, value: value / 127, continuous: true };\n    }\n    case \"noteOn\":\n    case \"noteOff\": {\n      const { key, velocity } = message;\n      const pressed = message.kind === \"noteOn\" && velocity > 0;\n      return { trigger: TRIGGER, source: `note:${key}`, label: `Note ${key}`, value: velocity / 127, continuous: false, pressed };\n    }\n    case \"pc\": {\n      const { program } = message;\n      return { trigger: TRIGGER, source: `pc:${program}`, label: `PC ${program + 1}`, value: 1, continuous: false };\n    }\n  }\n}\nexport {\n  index_default as default\n};\n"}