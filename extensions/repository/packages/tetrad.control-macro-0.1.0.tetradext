{"format":1,"manifest":{"id":"tetrad.control-macro","name":"Control Macro","version":"0.1.0","description":"Test fixture without MIDI: one command sets the first parameter of the first block to 50%.","api":1,"capabilities":["controlsRead","controlsEdit"],"settings":[],"commands":[{"id":"set-first","label":"Set first block to 50%"}]},"module":"// src/index.ts\nvar extension = {\n  activate(ctx) {\n    ctx.commands.register(\"set-first\", async (scope) => {\n      const block = (await scope.controls.list()).find((b) => b.parameters.length > 0);\n      const parameter = block?.parameters[0];\n      if (block === void 0 || parameter === void 0) {\n        await scope.ui.setStatus([\"No block with parameters in this preset\"]);\n        return;\n      }\n      await scope.controls.set(bindingFor(block, parameter.index), 0.5);\n      await scope.ui.setStatus([`${block.name}: ${parameter.name} set to 50%`]);\n    });\n  }\n};\nvar index_default = extension;\nfunction bindingFor(block, index) {\n  const control = { kind: \"parameter\", index };\n  const { model } = block;\n  switch (block.site) {\n    case \"slot\":\n      return { site: block.site, row: block.row, column: block.column, model, control };\n    case \"input\":\n    case \"output\":\n      return { site: block.site, row: block.row, model, control };\n    case \"splitter\":\n    case \"mixer\":\n      return { site: block.site, pair: block.pair, model, control };\n  }\n}\nexport {\n  index_default as default\n};\n"}